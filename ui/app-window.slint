import {
    VerticalBox,
    HorizontalBox,
    ScrollView,
    Button,
} from "std-widgets.slint";

import { DropZone } from "drop-zone.slint";
import { ImageCard } from "image-card.slint";
import { ToolBar } from "toolbar.slint";
import { ComparisonSlider } from "comparison-view.slint";
import { ImageItem } from "types.slint";

export { ImageItem }

export component AppWindow inherits Window {
    title: "PixelCrush — Image Optimizer";
    preferred-width: 1280px;
    preferred-height: 860px;
    background: #0d0d1a;
    icon: @image-url("../assets/icon.png");

    in-out property <[ImageItem]> images: [];
    in property <bool> is-processing: false;
    in property <string> status-text: "Drop images here";
    in-out property <int> comparison-index: -1;
    in-out property <bool> show-about: false;

    callback add-images();
    callback remove-image(int);
    callback compress-all();
    callback compress-single(int, int);
    callback export-image(int, string);
    callback drop-files([string]);
    callback set-quality(int, int);
    callback set-format(int, string);
    callback save-all();
    callback close-comparison();
    callback set-target-size-percent(int, int);
    callback set-max-dimension(int, int);
    callback apply-to-all(int);

    // ─── EMPTY STATE: Drop Zone ───────────────────────────────────────────
    if images.length == 0: DropZone {
        width: root.width;
        x: -1px;
        y: 0px;
        height: root.height;
        clicked => {
            root.add-images();
        }
    }

    // ─── MAIN VIEW ───────────────────────────────────────────────────────
    if images.length > 0: Rectangle {
        background: #0d0d1a;
        width: root.width;
        height: root.height;

        VerticalLayout {
            padding: 0px;
            spacing: 0px;

            // Header / Toolbar
            ToolBar {
                image-count: images.length;
                is-processing: root.is-processing;
                status-text: root.status-text;
                compress-all => {
                    root.compress-all();
                }
                add-more => {
                    root.add-images();
                }
                save-all => {
                    root.save-all();
                }
                clear-all => {
                    root.images = [];
                }
            }

            // Image grid (scrollable)
            ScrollView {
                height: root.height - 76px;

                VerticalLayout {
                    padding: 24px;
                    spacing: 20px;
                    alignment: start;

                    // Responsive dynamic grid for any number of images
                Rectangle {
                        property <int> cols: Math.max(1, Math.floor((root.width - 48px) / 300px));
                        height: 24px + Math.ceil(images.length / cols) * 540px;

                        for img[i] in root.images: ImageCard {
                            x: 24px + (i - Math.floor(i / cols) * cols) * 300px;
                            y: 24px + Math.floor(i / cols) * 540px;

                            image-data: img;
                            index: i;
                            remove => { root.remove-image(i); }
                            quality-changed(q) => { root.set-quality(i, q); }
                            compress => { root.compress-single(i, img.quality); }
                            format-changed(f) => { root.set-format(i, f); }
                            view-comparison => { root.comparison-index = i; }
                            save => { root.export-image(i, img.target-format); }
                            
                            target-size-percent-changed(p) => { root.set-target-size-percent(i, p); }
                            max-dimension-changed(d) => { root.set-max-dimension(i, d); }
                            apply-to-all => { root.apply-to-all(i); }
                        }
                    }

                    // ─── About / Credits section ─────────────────────────────────
                    Rectangle {
                        height: 1px;
                        background: #ffffff0a;
                    }

                    Rectangle {
                        border-radius: 16px;
                        background: #111125;
                        border-color: #ffffff10;
                        border-width: 1px;

                        VerticalLayout {
                            padding: 20px;
                            spacing: 16px;

                            // Section title row
                            HorizontalLayout {
                                spacing: 10px;
                                alignment: start;
                                Text {
                                    text: "ℹ About & Tech Stack";
                                    color: #a78bfa;
                                    font-size: 14px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }

                            // Tools grid
                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;

                                // Slint
                                Rectangle {
                                    border-radius: 12px;
                                    background: #7c3aed18;
                                    border-color: #7c3aed40;
                                    border-width: 1px;
                                    width: 180px;
                                    height: 60px;
                                    HorizontalLayout {
                                        padding: 12px;
                                        spacing: 10px;
                                        alignment: start;
                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: "Slint";
                                                color: #c4b5fd;
                                                font-size: 13px;
                                                font-weight: 700;
                                            }

                                            Text {
                                                text: "UI Framework";
                                                color: #64748b;
                                                font-size: 10px;
                                            }
                                        }
                                    }
                                }

                                // Rust
                                Rectangle {
                                    border-radius: 12px;
                                    background: #2d1a0a;
                                    border-color: #f9731640;
                                    border-width: 1px;
                                    width: 180px;
                                    height: 60px;
                                    HorizontalLayout {
                                        padding: 12px;
                                        spacing: 10px;
                                        alignment: start;
                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: "Rust";
                                                color: #fb923c;
                                                font-size: 13px;
                                                font-weight: 700;
                                            }

                                            Text {
                                                text: "Backend & Performance";
                                                color: #64748b;
                                                font-size: 10px;
                                            }
                                        }
                                    }
                                }

                                // mozjpeg
                                Rectangle {
                                    border-radius: 12px;
                                    background: #00d4aa18;
                                    border-color: #00d4aa40;
                                    border-width: 1px;
                                    width: 180px;
                                    height: 60px;
                                    HorizontalLayout {
                                        padding: 12px;
                                        spacing: 10px;
                                        alignment: start;
                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: "mozjpeg / oxipng";
                                                color: #34d399;
                                                font-size: 12px;
                                                font-weight: 700;
                                            }

                                            Text {
                                                text: "JPEG & PNG Encoding";
                                                color: #64748b;
                                                font-size: 10px;
                                            }
                                        }
                                    }
                                }

                                // WebP
                                Rectangle {
                                    border-radius: 12px;
                                    background: #3b82f618;
                                    border-color: #3b82f640;
                                    border-width: 1px;
                                    width: 180px;
                                    height: 60px;
                                    HorizontalLayout {
                                        padding: 12px;
                                        spacing: 10px;
                                        alignment: start;
                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: "libwebp";
                                                color: #60a5fa;
                                                font-size: 13px;
                                                font-weight: 700;
                                            }

                                            Text {
                                                text: "WebP Encoding";
                                                color: #64748b;
                                                font-size: 10px;
                                            }
                                        }
                                    }
                                }
                            }

                            // Slint license notice
                            Rectangle {
                                border-radius: 10px;
                                background: #7c3aed10;
                                border-color: #7c3aed30;
                                border-width: 1px;
                                height: 44px;

                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    spacing: 10px;
                                    alignment: start;

                                    Text {
                                        text: "Built with";
                                        color: #64748b;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                    }
                                    // Slint logo badge
                                    Rectangle {
                                        border-radius: 6px;
                                        background: #7c3aed30;
                                        border-color: #7c3aed60;
                                        border-width: 1px;
                                        width: 54px;
                                        height: 24px;
                                        y: 10px;
                                        Text {
                                            text: "Slint";
                                            color: #a78bfa;
                                            font-size: 11px;
                                            font-weight: 800;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    Text {
                                        text: "— GUI powered by Slint (slint.dev) under the Slint Royalty-Free License.";
                                        color: #475569;
                                        font-size: 10px;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // Version / copyright
                            Text {
                                text: "PixelCrush v1.0.5 — © 2026 torocruzand — MIT License";
                                color: #334155;
                                font-size: 10px;
                                horizontal-alignment: right;
                            }
                        }
                    }
                }
            }
        }
    }

    // ─── PROCESSING OVERLAY ───────────────────────────────────────────────
    if is-processing: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: #000000a0;
        TouchArea {} // Blocks all clicks to underneath elements
        
        VerticalLayout {
            alignment: center;
            spacing: 16px;
            Text {
                text: "⏳";
                font-size: 32px;
                horizontal-alignment: center;
            }
            Text {
                text: root.status-text;
                color: #f8fafc;
                font-size: 16px;
                font-weight: 600;
                horizontal-alignment: center;
            }
        }
    }

    // ─── COMPARISON OVERLAY ───────────────────────────────────────────────
    if comparison-index >= 0 && images.length > comparison-index: ComparisonSlider {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        before-image: images[comparison-index].thumbnail;
        after-image: images[comparison-index].compressed-thumbnail;
        file-name: images[comparison-index].file-name;
        original-size: images[comparison-index].original-size;
        compressed-size: images[comparison-index].compressed-size;
        close => {
            root.comparison-index = -1;
        }
    }
}
