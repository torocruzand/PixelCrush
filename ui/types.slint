// Shared data structures used across components
export struct ImageItem {
    id: int,
    file-name: string,
    file-path: string,
    original-size: int,
    compressed-size: int,
    original-width: int,
    original-height: int,
    format: string,
    target-format: string,
    quality: int,
    status: string,
    thumbnail: image,
    compressed-thumbnail: image,
    compression-ratio: float,
    max-dimension: string,
    target-size-percent: int,
    limit-size: bool,
}
