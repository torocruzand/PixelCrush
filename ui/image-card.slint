import { ImageItem } from "types.slint";

export component ImageCard inherits Rectangle {
    in property <ImageItem> image-data;
    in property <int> index;

    callback remove();
    callback quality-changed(int);
    callback compress();
    callback format-changed(string);
    callback view-comparison();
    callback save();

    width: 280px;
    height: 400px;
    border-radius: 16px;
    // hover driven by all touch areas so it doesn't flicker when hovering buttons
    property <bool> is-hovered: card-hover-ta.has-hover || remove-ta.has-hover || compare-ta.has-hover || slider-ta.has-hover || compress-ta.has-hover || save-ta.has-hover;
    background: is-hovered ? #1c1c3a : #161630;
    border-color: #ffffff10;
    border-width: 1px;
    drop-shadow-color: #00000060;
    drop-shadow-blur: 20px;
    drop-shadow-offset-y: 6px;
    animate background { duration: 180ms; }

    // ── card-level hover detector — declared FIRST so it's BEHIND buttons ──
    card-hover-ta := TouchArea {}

    // ─── Thumbnail area ───────────────────────────────────────────────
    thumb-clip := Rectangle {
        x: 0; y: 0;
        width: parent.width;
        height: 165px;
        border-radius: 16px;
        clip: true;
        background: #0a0a18;

        Image {
            source: image-data.thumbnail;
            width: 100%;
            height: 100%;
            image-fit: cover;
        }

        // Status badge — done
        if image-data.status == "done": Rectangle {
            x: parent.width - 72px;
            y: 10px;
            width: 62px;
            height: 26px;
            border-radius: 13px;
            background: #00d4aa20;
            border-color: #00d4aa50;
            border-width: 1px;
            Text {
                text: "-" + round(image-data.compression-ratio * 100) + "%";
                color: #00d4aa; font-size: 11px; font-weight: 700;
                horizontal-alignment: center; vertical-alignment: center;
            }
        }

        // Status badge — processing
        if image-data.status == "processing": Rectangle {
            x: parent.width - 90px;
            y: 10px;
            width: 80px; height: 26px;
            border-radius: 13px;
            background: #f59e0b20; border-color: #f59e0b50; border-width: 1px;
            Text {
                text: "Processing…";
                color: #fbbf24; font-size: 10px; font-weight: 700;
                horizontal-alignment: center; vertical-alignment: center;
            }
        }

        // Status badge — error
        if image-data.status == "error": Rectangle {
            x: parent.width - 55px;
            y: 10px;
            width: 45px; height: 26px;
            border-radius: 13px;
            background: #ef444420; border-color: #ef444450; border-width: 1px;
            Text {
                text: "Error";
                color: #f87171; font-size: 11px; font-weight: 700;
                horizontal-alignment: center; vertical-alignment: center;
            }
        }

        // Compare button — own TouchArea, on TOP of card-hover-ta
        if image-data.status == "done": compare-btn := Rectangle {
            x: 10px; y: 10px;
            width: 78px; height: 26px;
            border-radius: 13px;
            background: compare-ta.has-hover ? #7c3aed60 : #7c3aed40;
            border-color: #7c3aed80; border-width: 1px;
            animate background { duration: 130ms; }

            Text {
                text: "↔ Compare";
                color: #c4b5fd; font-size: 10px; font-weight: 700;
                horizontal-alignment: center; vertical-alignment: center;
            }
            compare-ta := TouchArea { clicked => { root.view-comparison(); } }
        }
        if image-data.status != "done": Rectangle {
            // invisible dummy to keep compare-ta valid
            compare-ta := TouchArea { visible: false; }
        }

        // Remove button — shown when card is hovered
        remove-btn := Rectangle {
            x: parent.width - 28px; y: 8px;
            width: 22px; height: 22px;
            border-radius: 11px;
            background: #ef4444;
            opacity: root.is-hovered ? 1.0 : 0.0;
            animate opacity { duration: 150ms; }

            Text {
                text: "×"; color: #fff; font-size: 13px; font-weight: 700;
                horizontal-alignment: center; vertical-alignment: center;
            }
            // remove TouchArea — ON TOP (declared last within remove-btn)
            remove-ta := TouchArea { clicked => { root.remove(); } }
        }
    }

    // ─── Content area ─────────────────────────────────────────────────
    VerticalLayout {
        x: 0; y: 165px;
        width: parent.width;
        height: parent.height - 165px;
        padding: 14px;
        spacing: 10px;

        Text {
            text: image-data.file-name;
            color: #e2e8f0; font-size: 13px; font-weight: 600;
            overflow: elide;
        }

        HorizontalLayout {
            spacing: 6px; alignment: start;
            Text { text: format-bytes(image-data.original-size); color: #64748b; font-size: 11px; }
            if image-data.status == "done": Text { text: "→"; color: #475569; font-size: 11px; }
            if image-data.status == "done": Text {
                text: format-bytes(image-data.compressed-size);
                color: #00d4aa; font-size: 11px; font-weight: 600;
            }
        }

        Text {
            text: image-data.original-width + "×" + image-data.original-height + " · " + image-data.format;
            color: #475569; font-size: 10px;
        }

        // Quality slider
        VerticalLayout {
            spacing: 4px;
            HorizontalLayout {
                alignment: stretch;
                Text { text: "Quality"; color: #94a3b8; font-size: 11px; vertical-alignment: center; }
                Text {
                    text: image-data.quality + "%";
                    color: #a78bfa; font-size: 11px; font-weight: 700;
                    horizontal-alignment: right; vertical-alignment: center;
                }
            }

            quality-track := Rectangle {
                height: 6px; border-radius: 3px; background: #1e1e38;

                Rectangle {
                    width: parent.width * (image-data.quality / 100.0);
                    height: 6px; border-radius: 3px;
                    background: @linear-gradient(90deg, #7c3aed 0%, #a78bfa 100%);
                    animate width { duration: 120ms; }
                }
                Rectangle {
                    x: (parent.width * (image-data.quality / 100.0)) - 7px;
                    y: -4px; width: 14px; height: 14px;
                    border-radius: 7px; background: #a78bfa;
                    border-color: #7c3aed; border-width: 2px;
                }

                // Slider TouchArea — declared AFTER fill rects so it's on top
                slider-ta := TouchArea {
                    moved => {
                        if self.pressed {
                            root.quality-changed(clamp(round(self.mouse-x / quality-track.width * 100), 1, 100));
                        }
                    }
                    pointer-event(e) => {
                        if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                            root.quality-changed(clamp(round(self.mouse-x / quality-track.width * 100), 1, 100));
                        }
                    }
                }
            }
        }

        // Action buttons
        HorizontalLayout {
            spacing: 8px; alignment: start;

            // Compress button
            compress-rect := Rectangle {
                height: 34px; min-width: 80px; border-radius: 8px;
                background: image-data.status == "done"
                    ? (compress-ta.has-hover ? #2a2a50 : #1e1e38)
                    : (compress-ta.has-hover ? #6d28d9 : #7c3aed);
                border-color: image-data.status == "done" ? #7c3aed80 : transparent;
                border-width: 1px;
                animate background { duration: 150ms; }

                Text {
                    text: image-data.status == "done" ? "↺ Redo"
                        : image-data.status == "processing" ? "…" : "Compress";
                    color: image-data.status == "done" ? #a78bfa : #fff;
                    font-size: 12px; font-weight: 700;
                    horizontal-alignment: center; vertical-alignment: center;
                }
                // TouchArea declared LAST inside compress-rect = on top
                compress-ta := TouchArea { clicked => { root.compress(); } }
            }

            // Save button (only when done)
            if image-data.status == "done": save-rect := Rectangle {
                width: 34px; height: 34px; border-radius: 8px;
                background: save-ta.has-hover ? #00d4aa30 : #00d4aa20;
                border-color: #00d4aa50; border-width: 1px;
                animate background { duration: 150ms; }

                Text {
                    text: "⬇"; color: #00d4aa; font-size: 14px;
                    horizontal-alignment: center; vertical-alignment: center;
                }
                save-ta := TouchArea { clicked => { root.save(); } }
            }
            if image-data.status != "done": Rectangle {
                // invisible dummy to keep save-ta valid
                save-ta := TouchArea { visible: false; }
            }
        }
    }

    pure function format-bytes(bytes: int) -> string {
        if bytes <= 0 { return "—"; }
        if bytes < 1024 { return bytes + " B"; }
        if bytes < 1048576 { return round(bytes / 102.4) / 10 + " KB"; }
        return round(bytes / 104857.6) / 10 + " MB";
    }
}
